# Runtime instalado pelo bootstrap.ps1 — não versionado.
# Pra reinstalar: rode `pwsh -File .\bootstrap.ps1`.
runtime/

# Python padrão
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Editores
.idea/
.vscode/
*.swp

# Logs temporarios de debug de sessao (vazaram 3x no repo - regra
# hard: nunca commitar logs de sessoes locais). `*.log` em geral nao
# entra pq sao uteis (rotacao etc); `tmp_*.log` e o que vaza.
tmp_*.log
*.tmp
